{
  "name": "@anqr/product",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\" \"packages/*/tests/**/*.test.ts\"",
    "test:conformance": "node --test \"tests/conformance/**/*.conformance.test.ts\"",
    "architecture": "node packages/architecture/src/check.ts",
    "architecture:json": "node packages/architecture/src/check.ts --json",
    "validate": "npm run typecheck && npm test && npm run architecture"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "typescript": "7.0.2"
  }
}
