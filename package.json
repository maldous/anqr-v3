{
  "name": "@anqr/product",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test \"tests/**/*.test.ts\" \"packages/*/tests/**/*.test.ts\" \"apps/*/tests/**/*.test.ts\"",
    "test:conformance": "node --test \"tests/conformance/**/*.conformance.test.ts\"",
    "architecture": "node packages/architecture/src/check.ts",
    "architecture:json": "node packages/architecture/src/check.ts --json",
    "validate": "npm run typecheck && npm test && npm run architecture && npm run build && npm run delivery",
    "build": "node apps/web/tools/build.mjs",
    "delivery": "node packages/architecture/src/delivery-cli.ts",
    "delivery:json": "node packages/architecture/src/delivery-cli.ts --json"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@types/node": "26.4.1",
    "esbuild": "0.28.2",
    "happy-dom": "20.13.2",
    "typescript": "7.0.2"
  }
}
