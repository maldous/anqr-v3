  "notRequired": [
    {
      "contract": "abacpolicydecisionpoint",
      "declared": true,
      "reason": "There is no subject, resource or environment tuple to decide about."
    },
    {
      "contract": "apikeyspersonalaccesstokens",
      "declared": true,
      "reason": "The agent surface verifies one operator-provisioned credential; there are no per-user keys to issue or rotate."
    },
    {
      "contract": "authenticationplatform",
      "declared": true,
      "reason": "No user account exists. The journey requires anonymity, and the only credential in the product authorises a machine consumer, not a person."
    },
    {
      "contract": "backupandrestore",
      "declared": true,
      "reason": "The only server-side state is a cache derived from its own key. Losing it costs time, never data, so backing it up would protect nothing."
    },
    {
      "contract": "brandingandtheming",
      "declared": true,
      "reason": "The product has one identity. A user brands their artefact, not the application."
    },
    {
      "contract": "compliancereportsaccessreviewsevidencepacks",
      "declared": true,
      "reason": "There is no access to review, because there are no accounts, no roles and no personal data. The audit record the product does keep is about machine requests to one surface and is modelled as its own capability."
    },
    {
      "contract": "datagovernancecataloglineageclassificationpiidsrgdpr",
      "declared": true,
      "reason": "The product deliberately holds no personal data; payload content stays on the client. Consent is required for advertising and is modelled as its own capability."
    },
    {
      "contract": "delegatedadministrationroles",
      "declared": true,
      "reason": "There is no administration to delegate. The two administrative actions the product has are performed by whoever controls the deployment, which is a deployment fact rather than a role in the product."
    },
    {
      "contract": "enduserprofileandpreferencesselfservice",
      "declared": true,
      "reason": "Preferences are device-local, because there is no profile to hold them."
    },
    {
      "contract": "eventbusdurablequeuesdlqredrive",
      "declared": true,
      "reason": "The one asynchronous path is a single render job addressed by identity, not a stream needing ordering, retry or a dead-letter path."
    },
    {
      "contract": "historyreadmodelreadonlyprojection",
      "declared": true,
      "reason": "Nothing is written, so nothing has a history to project. The only server-side state is a regenerable cache whose past values carry no meaning."
    },
    {
      "contract": "notificationdeliveryandpreferencesandchannels",
      "declared": true,
      "reason": "The product notifies nobody because it has nobody to notify. With no accounts there is no address to reach, no preference to respect and no channel to choose."
    },
    {
      "contract": "pitrretentionlegalholddataresidency",
      "declared": true,
      "reason": "There is no retained personal data to hold, reside or recover to a point in time."
    },
    {
      "contract": "productcatalogplansprices",
      "declared": true,
      "reason": "One free tier and one gated tier, declared as an entitlement rather than a catalogue."
    },
    {
      "contract": "rbacrolesandpermissions",
      "declared": true,
      "reason": "With no accounts there are no roles to assign, and nothing in the product varies by who is asking. The one credential that exists authorises a machine to call one surface, which is an entitlement rather than a role."
    },
    {
      "contract": "relationalstorageandmigrationsandrls",
      "declared": true,
      "reason": "The product stores nothing between requests. Creation is client-side and the only server state is a regenerable cache, so there is no schema to migrate and no row to isolate."
    },
    {
      "contract": "scheduledjobsbuiltinontheeventsubstrate",
      "declared": true,
      "reason": "Nothing in the product runs on a clock. Every server-side action is triggered by a request, and the one background job is started by the request that exceeded the synchronous bound rather than by a schedule."
    },
    {
      "contract": "searchandindexingproductsearch",
      "declared": true,
      "reason": "Search is over the product's own control surface and content, resolved on the client. No server index exists."
    },
    {
      "contract": "suborganisations",
      "declared": true,
      "reason": "Nothing is organised into anything. There is no account tree, no parent-child relationship and no scope that a sub-organisation would narrow."
    },
    {
      "contract": "subscriptionsinvoicespaymentmethodsdunning",
      "declared": true,
      "reason": "No billing runs inside the product; an entitlement arrives already paid for."
    },
    {
      "contract": "supportmodebreakglassaccess",
      "declared": true,
      "reason": "There is no user data to break glass into. Payload content stays on the client and is never transmitted, so an emergency access path would reach nothing that belongs to anyone."
    },
    {
      "contract": "supportticketscustomerhealthannouncements",
      "declared": true,
      "reason": "Support is a contact route on a static page. With no accounts there is no customer record to attach a ticket to, no health signal to compute and no audience to announce to."
    },
    {
      "contract": "tenantcanonicaldomainsetunset",
      "declared": true,
      "reason": "The product has one canonical domain, set once, not per tenant."
    },
    {
      "contract": "tenantdataimportexport",
      "declared": true,
      "reason": "No tenant data exists. Artefact export is a product capability and is not this."
    },
    {
      "contract": "tenantdomainactivationauthclient",
      "declared": true,
      "reason": "No per-tenant authentication client exists, because there is no tenant and no authentication. The product serves one canonical domain and identifies nobody."
    },
    {
      "contract": "tenantgroups",
      "declared": true,
      "reason": "There are no tenants, so there is nothing to group. Every visitor is anonymous and every API consumer is authorised by one operator-provisioned credential rather than by membership of anything."
    },
    {
      "contract": "tenanthostidentityresolution",
      "declared": true,
      "reason": "One host resolves to one product. There is no mapping from an incoming hostname to a tenant identity because no such identity exists."
    },
    {
      "contract": "tenantidentityrecordandfqdn",
      "declared": true,
      "reason": "There is no tenant identity record to hold, and no fully-qualified name is assigned per customer. The product has one name that belongs to the product."
    },
    {
      "contract": "tenantisolationproof",
      "declared": true,
      "reason": "There is nothing to isolate, and claiming isolation over an empty set would be the emptiest possible proof."
    },
    {
      "contract": "tenantlifecycleprovisionsuspenddeleteexport",
      "declared": true,
      "reason": "No tenant is provisioned, so none can be suspended, deleted or exported. The lifecycle this contract manages has no subject in a product where every visitor arrives with no prior state."
    },
    {
      "contract": "tenantserviceclickthroughpolicy",
      "declared": true,
      "reason": "No per-tenant policy is presented, because there is no tenant to present it to. The policies the product does present are its own terms and privacy pages, served as localised static content."
    },
    {
      "contract": "usagemeteringandmetereventingestion",
      "declared": true,
      "reason": "Nothing is metered. The tier is an entitlement that is either active or not, deliberately rather than incidentally: metering anonymous use would require identifying it."
    },
    {
      "contract": "useridentityandtenantmembership",
      "declared": true,
      "reason": "There is no user record to belong to anything. The journey requires anonymity, so identity is not merely absent from the implementation, it is a product commitment the model would contradict."
    },
    {
      "contract": "webhooksdeveloperfacing",
      "declared": true,
      "reason": "The API is request-response and holds no consumer registration. Nothing is delivered back because there is no consumer record to deliver to and no event that outlives its request."
    },
    {
      "contract": "workflowenginescheduledjobsapprovals",
      "declared": true,
      "reason": "No product behaviour is a multi-step workflow. The one asynchronous path is a single render job addressed by its own identity, with no state machine, no approval step and nothing to resume."
    }
  ],
